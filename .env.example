# Copiez ce fichier en « .env » pour travailler sur votre ordinateur.
# En production, définissez ces variables dans l'interface de votre hébergeur.

# 1 = mode développement (jamais en production)
DJANGO_DEBUG=1

# Clé secrète : générez-en une avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Noms de domaine autorisés, séparés par des virgules (ex. app.scolapay.ci)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS de confiance pour les formulaires (ex. https://app.scolapay.ci)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de données : SQLite par défaut. Pour PostgreSQL :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/scolapay

TIME_ZONE=Africa/Abidjan

# Pour docker-compose sur un VPS : votre nom de domaine (certificat HTTPS automatique)
DOMAIN=app.exemple.ci
